<!doctype html>
<html lang="{{ design.language }}">
<head>
<meta charset="utf-8">
<title>{{ design.design_id }}</title>
<style>
{% for f in fonts %}
@font-face { font-family: "{{ f.family }}"; src: url("{{ f.uri }}"); font-weight: {{ f.weight }}; font-display: block; }
{% endfor %}
:root{
  --red: {{ brand.red }};
  --red-80: {{ brand.colour_hex('core.red.80') }};
  --red-20: {{ brand.colour_hex('core.red.20') }};
  --charcoal: {{ brand.charcoal }};
  --charcoal-60: {{ brand.colour_hex('core.charcoal.60') }};
  --charcoal-80: {{ brand.colour_hex('core.charcoal.80') }};
  --charcoal-20: {{ brand.colour_hex('core.charcoal.20') }};
  --white: #FFFFFF;
  --margin: {{ margin }}px;
  --gutter: {{ gutter }}px;
  --unit: {{ unit }}px;                 /* 4px soft grid */
  --display: "AIAEverest", "Open Sans", Arial, sans-serif;
  --body: "Open Sans", Arial, sans-serif;
  --zh: "Noto Sans SC", "Open Sans", sans-serif;
  --ta: "Noto Sans Tamil", "Open Sans", sans-serif;
}
*{ box-sizing: border-box; margin:0; padding:0; }
html,body{ width:{{ design.canvas.width }}px; height:{{ design.canvas.height }}px; }
body{ font-family: var(--body); color: var(--charcoal); background: var(--white);
      -webkit-font-smoothing: antialiased; text-rendering: geometricPrecision; }
.poster{ position:relative; width:{{ design.canvas.width }}px; height:{{ design.canvas.height }}px;
         overflow:hidden; background:{{ background.colour or '#FFFFFF' }}; }
.poster.theme-bold{ background: var(--red); color: var(--white); }
.bg-image{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
/* generated imagery sits under a brand scrim so text keeps its contrast */
.scrim{ position:absolute; inset:0;
        background: linear-gradient(180deg, rgba(255,255,255,.96) 0%, rgba(255,255,255,.88) 38%,
                    rgba(255,255,255,.35) 62%, rgba(255,255,255,.10) 100%); }
.theme-bold .scrim{ background: linear-gradient(180deg, rgba(211,17,69,.94) 0%, rgba(211,17,69,.86) 45%,
                    rgba(211,17,69,.55) 100%); }
.mountains-wrap{ position:absolute; pointer-events:none; }
.mountains{ display:block; }
.logo{ display:block; }
.headline{ font-family: var(--display); font-weight:700; letter-spacing:-0.01em; text-transform: uppercase; }
.subheadline{ font-family: var(--display); font-weight:500; }
.body-copy{ font-family: var(--display); font-weight:400; }
.cta{ display:inline-block; font-family: var(--display); font-weight:500; border-radius: 999px;
      padding: calc(var(--unit)*3) calc(var(--unit)*7); background: var(--red); color: var(--white); }
.theme-bold .cta{ background: var(--white); color: var(--red); }
.fact{ font-family: var(--display); font-weight:500; }
.contact-block{ font-family: var(--display); line-height:1.35; }
.contact-block .name{ font-weight:700; }
.disclaimer{ font-family: var(--body); color: var(--charcoal-80); }
.theme-bold .disclaimer{ color: rgba(255,255,255,.85); }
.agent-photo{ display:block; object-fit:cover; object-position:top center; }
.qr{ display:block; background:var(--white); padding:calc(var(--unit)*2); border-radius:calc(var(--unit)*2); }
[lang="zh-Hans"], .zh{ font-family: var(--zh); line-height:1.35; }
[lang="ta"], .ta{ font-family: var(--ta); line-height:1.5; }
{% block layout_css %}{% endblock %}
</style>
</head>
<body>
<div class="poster theme-{{ design.theme.value if design.theme.value is defined else design.theme }}"
     data-design="{{ design.design_id }}" data-version="{{ design.version }}">
  {% if background.kind != 'solid' and background.src %}
    <img class="bg-image" src="{{ background.src }}" alt="">
    <div class="scrim"></div>
  {% endif %}
  {% block body %}{% endblock %}
</div>
</body>
</html>
