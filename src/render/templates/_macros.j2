{% macro element(e) %}
{% set s = e.style %}
{% set size = (s.size | default(24)) * scale_factor * e.scale %}
{% if e.type == 'logo' %}
  <img id="{{ e.id }}" class="logo" src="{{ e.src }}" alt="AIA"
       style="height:{{ (e.overrides.get('height') | default(logo_height, true)) * e.scale }}px">
{% elif e.type == 'agent_photo' %}
  {% set shape = e.overrides.get('shape') | default('cutout', true) %}
  <img id="{{ e.id }}" class="agent-photo shape-{{ shape }}" src="{{ e.src }}" alt=""
       style="width:{{ (e.overrides.get('width') | default(photo_width, true)) * e.scale }}px;
              height:{{ (e.overrides.get('height') | default(photo_height, true)) * e.scale }}px;
              object-fit:{{ 'contain' if shape == 'cutout' else 'cover' }};
              {% if shape == 'cutout' and e.overrides.get('shadow') %}filter: drop-shadow(0 18px 34px rgba(26,30,36,.26));{% endif %}">
{% elif e.type == 'qr' %}
  <img id="{{ e.id }}" class="qr" src="{{ e.src }}" alt="" data-qr-target="{{ e.qr_target }}"
       style="width:{{ (e.overrides.get('size') | default(qr_size, true)) * e.scale }}px">
{% elif e.type == 'mountains' %}
  <div id="{{ e.id }}" class="mountains-wrap" style="{{ e.overrides.get('position') | default('inset:auto 0 0 0;', true) }}
       width:{{ e.overrides.get('width') | default(design.canvas.width, true) }}px;
       height:{{ (e.overrides.get('height') | default(design.canvas.height * 0.42, true)) * e.scale }}px">{{ e.svg | safe }}</div>
{% elif e.type == 'image' %}
  <img id="{{ e.id }}" class="art" src="{{ e.src }}" alt="" style="{{ e.overrides.get('style') | default('', true) }}">
{% elif e.type == 'contact_block' %}
  <div id="{{ e.id }}" class="contact-block" style="font-size:{{ size }}px">
    {% for line in e.lines %}<div class="{{ 'name' if loop.first }}">{{ line }}</div>{% endfor %}
  </div>
{% elif e.type == 'cta' %}
  <span id="{{ e.id }}" class="cta" style="font-size:{{ size }}px">{{ e.text }}</span>
{% elif e.type == 'disclaimer' %}
  <p id="{{ e.id }}" class="disclaimer" style="font-size:{{ size }}px; line-height:{{ s.line_height_mult | default(1.3) }}">{{ e.text }}</p>
{% else %}
  <div id="{{ e.id }}" class="{{ 'headline' if e.type=='headline' else 'subheadline' if e.type=='subheadline' else 'body-copy' if e.type=='body' else 'fact' }}"
       style="font-size:{{ size }}px; line-height:{{ s.line_height_mult | default(1.2) }};
              {% if e.overrides.get('colour') %}color:{{ e.overrides.get('colour') }};{% endif %}">{{ e.text }}</div>
{% endif %}
{% endmacro %}

{% macro slot(name) %}
  {% for e in elements_by_slot.get(name, []) %}{{ element(e) }}{% endfor %}
{% endmacro %}
